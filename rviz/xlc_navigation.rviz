Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /PLY Global Map1
        - /LaserScan1
        - /Global Plan1
        - /Local Plan1
    Tree Height: 700
  - Class: rviz/Tool Properties
    Name: Tool Properties
    Expanded:
      - /2D Nav Goal1
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 40
      Color: 80; 80; 80
      Alpha: 0.5
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map_grid
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: true
    - Class: rviz/PointCloud2
      Name: PLY Global Map
      Enabled: true
      Topic: /map
      Queue Size: 2
      Selectable: true
      Style: Points
      Size (Pixels): 2
      Size (m): 0.025
      Color Transformer: RGB8
      Axis: Z
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Alpha: 0.65
      Decay Time: 0
    - Class: rviz/Map
      Name: Local Costmap
      Enabled: true
      Topic: /move_base/local_costmap/costmap
      Alpha: 0.35
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz/PointCloud2
      Name: Live LiDAR in map frame (red)
      Enabled: true
      Topic: /cloud_registered_map
      Queue Size: 2
      Selectable: true
      Style: Points
      Size (Pixels): 3
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Alpha: 0.9
      Decay Time: 0.15
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /laser_scan
      Size (Pixels): 3
      Style: Points
      Color: 255; 40; 40
      Decay Time: 0
    - Class: rviz/Path
      Name: Global Plan
      Enabled: true
      Topic: /move_base/GlobalPlanner/plan
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
    - Class: rviz/Path
      Name: Local Plan
      Enabled: true
      Topic: /move_base/TebLocalPlannerROS/local_plan
      Color: 255; 200; 0
      Line Style: Lines
      Line Width: 0.08
      Buffer Length: 1
    - Class: rviz/TF
      Name: Robot TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.4
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: false
        go2_link:
          Value: true
        laser_link:
          Value: true
        map:
          Value: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
      Theta std deviation: 0.261799
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Topic: /clicked_point
      Single click: true
  Views:
    Current:
      Class: rviz/Orbit
      Name: 3D Map and LiDAR
      Distance: 13
      Focal Point:
        X: 2
        Y: 1
        Z: 0
      Pitch: 0.65
      Yaw: 0.8
      Near Clip Distance: 0.01
    Saved:
      - Class: rviz/Orbit
        Name: 3D Orbit
        Distance: 13
        Focal Point:
          X: 2
          Y: 1
          Z: 0
        Pitch: 0.65
        Yaw: 0.8
        Near Clip Distance: 0.01
Window Geometry:
  Height: 900
  Width: 1440
  X: 20
  Y: 20
